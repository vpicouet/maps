{"id": 3267296711212378, "title": "Security policy, measures, risks and staff awareness by size class of enterprise", "unit": "", "source": "Eurostat", "citation": "Eurostat (2026)", "url": "https://ec.europa.eu/eurostat/databrowser/view/ISOC_CISCE_RA/default/table", "log": false, "ready": false, "dimensions": [{"id": "size_emp", "label": "Size classes in number of persons employed", "options": [{"code": "0_1", "label": "From 0 to 1 person employed"}, {"code": "0-9", "label": "From 0 to 9 persons employed"}, {"code": "1-9", "label": "From 1 to 9 persons employed"}, {"code": "2-9", "label": "From 2 to 9 persons employed"}, {"code": "10-49", "label": "From 10 to 49 persons employed"}, {"code": "10-249", "label": "From 10 to 249 persons employed"}, {"code": "GE10", "label": "10 persons employed or more"}, {"code": "50-249", "label": "From 50 to 249 persons employed"}, {"code": "GE250", "label": "250 persons employed or more"}], "default": "10-249", "has_total": false}, {"id": "indic_is", "label": "Information society indicator", "options": [{"code": "E_SECMSPSW", "label": "ICT security measure used: strong password authentication"}, {"code": "E_SECMKSUD", "label": "ICT security measure used: keeping the software (including operating systems) up-to-date"}, {"code": "E_SECMUIBM", "label": "ICT security measure used: authentication via biometric methods implemented by the enterprise"}, {"code": "E_SECMDENC", "label": "ICT security measure used: encryption techniques for data, documents or e-mails"}, {"code": "E_SECMOSBU", "label": "ICT security measure used: data backup to a separate location (including backup to the cloud)"}, {"code": "E_SECMNAC", "label": "ICT security measure used: network access control (management of access by devices and users to the enterprise's network)"}, {"code": "E_SECMVPN", "label": "ICT security measure used: VPN (Virtual Private Network extends a private network across a public network to enable secure exchange of data over public network)"}