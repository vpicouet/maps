{"id": 3755898559623423, "title": "Artificial intelligence by size class of enterprise", "unit": "", "source": "Eurostat", "citation": "Eurostat (2026)", "url": "https://ec.europa.eu/eurostat/databrowser/view/ISOC_EB_AI/default/table", "log": false, "ready": false, "dimensions": [{"id": "size_emp", "label": "Size classes in number of persons employed", "options": [{"code": "0-9", "label": "From 0 to 9 persons employed"}, {"code": "2-9", "label": "From 2 to 9 persons employed"}, {"code": "10-49", "label": "From 10 to 49 persons employed"}, {"code": "10-249", "label": "From 10 to 249 persons employed"}, {"code": "GE10", "label": "10 persons employed or more"}, {"code": "50-249", "label": "From 50 to 249 persons employed"}, {"code": "GE250", "label": "250 persons employed or more"}], "default": "10-249", "has_total": false}, {"id": "indic_is", "label": "Information society indicator", "options": [{"code": "E_AI_TTM", "label": "Enterprises using AI technologies performing analysis of written language (text mining)"}, {"code": "E_AI_TSR", "label": "Enterprises using AI technologies converting spoken language into machine-readable format (speech recognition)"}, {"code": "E_AI_TNLG", "label": "Enterprises using AI technologies generating written or spoken language or programming codes (natural language generation, speech synthesis)"}, {"code": "E_AI_TIR", "label": "Enterprises using AI technologies identifying objects or persons based on images (image recognition, image processing)"}, {"code": "E_AI_TML", "label": "Enterprises using machine learning (e.g. deep learning) for data analysis"}, {"code": "E_AI_TPA", "label": "Enterprises using AI technologies automating different workflows or assisting in decision making (AI based software robotic process automation)"}, {"code": "E_AI_TAR", "label": "Enterprises using AI technologies enabling physical movement of machines via autonomous decisions based on observation of surroundings (autonomous robots, self-driving vehicles, autonomous drones)"}, {"code": "E_AI_TANY", "label": "Enterprises using at least one of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR, E_AI_TPVSG"}, {"code": "E_AI_TX", "label": "Enterprises don't use any of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR, E_AI_TPVSG"}, {"code": "E_AI_TGE2", "label": "Enterprises using at least two of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR, E_AI_TPVSG"}, {"code": "E_AI_TGE3", "label": "Enterprises using at least three of the AI technologies: AI_TTM, AI_TSR, AI_TNLG, AI_TIR, AI_TML, AI_TPA, AI_TAR, E_AI_TPVSG"}, {"code": "E_AI_PMS", "label": "Enterprises using AI technologies for marketing or sales"}, {"code": "E_AI_PPP", "label": "Enterprises using AI technologies for production processes"}, {"code": "E_AI_PBA", "label": "Enterprises using AI technologies for organisation of business administration processes"}, {"code": "E_AI_PME", "label": "Enterprises using AI technologies for management of enterprises"}, {"code": "E_AI_PLOG", "label": "Enterprises using AI technologies for logistics"}, {"code": "E_AI_PITS", "label": "Enterprises using AI technologies for ICT security"}, {"code": "E_AI_PHR", "label": "Enterprises using AI technologies for human resources management or recruiting"}, {"code": "E_AI_ADOWN", "label": "Enterprises' AI technologies were developed by own employees"}, {"code": "E_AI_AMOWN", "label": "Enterprises' AI technologies were commercial software or systems modified by own employees"}, {"code": "E_AI_AOS", "label": "Enterprises' AI technologies were open-source software or systems modified by own employees"}, {"code": "E_AI_ARDY", "label": "Enterprises' AI technologies were commercial software or systems ready to use"}, {"code": "E_AI_AEXT", "label": "Enterprises' AI technologies were  developed or modified by external providers"}, {"code": "E_AI_EC", "label": "Enterprises that ever considered to use one of the AI techno